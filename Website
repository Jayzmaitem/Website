    const toastEl = document.getElementById('toast');
    const editToggle = document.getElementById('editToggle');
    const songBox = document.getElementById('songBox');

    /* ---------- Utilities ---------- */
    function toast(msg) {
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      clearTimeout(toast.t);
      toast.t = setTimeout(() => toastEl.classList.remove('show'), 2200);
    }

    function setIG(username) {
      igLink.href = 'https://www.instagram.com/' + username;
      igLabel.textContent = '📸 IG: ' + username;
      infoContact.textContent = 'IG: ' + username;
    }

    function getIGUsername() {
      return igLink.g
